    <stages><li><statFactors><MeleeDamageFactor>1.75</MeleeDamageFactor><MeleeHitChance>1.5</MeleeHitChance></statFactors></li></stages>
  </HediffDef>
  <HediffDef>
    <defName>Calido_FallenAngelForm</defName><label>墮天使形態</label><description>邪教支線留下的復生烙印正在燃燒。六十秒後，代價將全部返還給身體。</description><hediffClass>HediffWithComps</hediffClass><isBad>false</isBad>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>3600</disappearsAfterTicks></li></comps>
    <stages><li><statOffsets><MoveSpeed>2</MoveSpeed></statOffsets><statFactors><IncomingDamageFactor>0.35</IncomingDamageFactor><MeleeDamageFactor>1.8</MeleeDamageFactor><ShootingAccuracyPawn>1.5</ShootingAccuracyPawn></statFactors></li></stages>
  </HediffDef>
  <HediffDef>
    <defName>Calido_FallenExhaustion</defName><label>墮落反噬</label><description>墮天使形態結束後的深度昏迷。</description><hediffClass>HediffWithComps</hediffClass><isBad>true</isBad>
